// PromoLiso — REDESIGN "BOLD GAMER ENERGY" (variante B)
// Grade reta, zero tilt. Tipo enorme e balanceado (auto-fit), destaque em SLAB neon,
// molduras HUD (corner brackets), motivo de chevrons, glow neon controlado.
// Preserva contratos: capa lê output; slide lê slide; CTA quando tipo==='cta'.
const fs = require('fs');
const path = require('path');
const http = require('http');
const OUT = __dirname;

const FONT = fs.readFileSync(path.join(OUT, 'asset_font.txt'), 'utf8');   // data: barlow condensed
const MASCOT = fs.readFileSync(path.join(OUT, 'asset_mascot.txt'), 'utf8');

// ---- tokens ----
const GREEN = '#9BFF25', PURPLE = '#8B2CFF', INK = '#050607';
const DISPLAY = "PLDisplay,'Barlow Condensed',Impact,sans-serif";
const STYLE = `<style>@font-face{font-family:PLDisplay;src:url(${FONT}) format('truetype');font-weight:100 900;}</style>`;

function esc(v){return String(v||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');}

// nitidez + qualidade
const QUAL = 'f_auto,q_auto:good,e_sharpen:80';
function cloud(source, transform){
  source = String(source||'');
  if(!/^https:\/\//i.test(source)) return '';
  if(/^https:\/\/res\.cloudinary\.com\/fy2n2qvr\//i.test(source)) return source;
  if(source.startsWith('https://image.mux.com/')) return source+(source.includes('?')?'&':'?')+'width=1600';
  return 'https://res.cloudinary.com/fy2n2qvr/image/fetch/'+transform+'/'+encodeURIComponent(source);
}

// ---- tipografia balanceada (quebras intencionais + auto-fit) ----
// Barlow Condensed Black e MUITO estreita: ~0.5em de avanco por glifo em caixa alta.
function balanceLines(text, maxPerLine){
  const words = String(text||'').trim().split(/\s+/).filter(Boolean);
  if (words.length <= 1) return words;
  const longest = Math.max(...words.map(w=>w.length));
  const greedy = (max)=>{
    const out=[]; let cur='';
    for(const w of words){
      if(!cur) cur=w;
      else if((cur+' '+w).length<=max) cur+=' '+w;
      else { out.push(cur); cur=w; }
    }
    if(cur) out.push(cur);
    return out;
  };
  const natural = greedy(Math.max(maxPerLine, longest));
  const L = natural.length;
  // rebalanceia: menor largura que ainda cabe em L linhas => linhas parelhas, sem orfas
  let lo = longest, hi = Math.max(maxPerLine, longest), best = natural;
  while(lo <= hi){
    const mid = (lo+hi)>>1;
    const g = greedy(mid);
    if(g.length <= L){ best = g; hi = mid-1; } else lo = mid+1;
  }
  return best;
}
function fitSize(lines, containerW, capMax, capMin, factor){
  factor = factor || 0.50;
  const maxLen = Math.max(1, ...lines.map(l=>l.length));
  let s = Math.floor(containerW / (maxLen*factor));
  return Math.max(capMin, Math.min(capMax, s));
}
// titulo branco enorme, uma linha por bloco (quebra controlada)
function titleBlock(text, containerW, capMax, capMin){
  const lines = balanceLines(text, capMax>=110?15:17);
  const size = fitSize(lines, containerW, capMax, capMin);
  const rows = lines.map(l=>`<div style="display:flex;">${esc(l.toUpperCase())}</div>`).join('');
  return `<div style="display:flex;flex-direction:column;color:#fff;font-family:${DISPLAY};font-weight:900;text-transform:uppercase;font-size:${size}px;line-height:.9;letter-spacing:-1px;text-shadow:0 3px 18px rgba(0,0,0,.75);">${rows}</div>`;
}
// destaque = SLABS neon verde (tinta escura sobre verde), empilhados e colados ao texto
function destaqueBlock(text, containerW, capMax, capMin, singleLine){
  if(!String(text||'').trim()) return '';
  const lines = singleLine ? [String(text).trim()] : balanceLines(text, 26);
  const size = fitSize(lines, containerW, capMax, capMin);
  const pad = Math.round(size*0.06);
  const rows = lines.map(l=>`<div style="display:flex;align-self:flex-start;background:${GREEN};color:${INK};font-family:${DISPLAY};font-weight:900;text-transform:uppercase;font-size:${size}px;line-height:1.02;letter-spacing:-1px;padding:${pad}px 16px;margin-top:8px;box-shadow:0 0 22px rgba(155,255,37,.24);">${esc(l.toUpperCase())}</div>`).join('');
  return `<div style="display:flex;flex-direction:column;">${rows}</div>`;
}

// chevrons de energia (motivo de "avanco")
function chevrons(size){
  size = size||22;
  return `<div style="display:flex;align-items:center;font-family:${DISPLAY};font-weight:900;font-size:${size}px;line-height:1;">`+
    `<span style="color:${GREEN};margin-right:-4px;">&rsaquo;</span>`+
    `<span style="color:${GREEN};opacity:.6;margin-right:-4px;">&rsaquo;</span>`+
    `<span style="color:${PURPLE};">&rsaquo;</span></div>`;
}
// cantos HUD neon (colocar dentro de um container position:relative)
function brackets(color, len, thick){
  len=len||34; thick=thick||4;
  return `
  <div style="position:absolute;left:0;top:0;width:${len}px;height:${len}px;border-left:${thick}px solid ${color};border-top:${thick}px solid ${color};"></div>
  <div style="position:absolute;right:0;top:0;width:${len}px;height:${len}px;border-right:${thick}px solid ${color};border-top:${thick}px solid ${color};"></div>
  <div style="position:absolute;left:0;bottom:0;width:${len}px;height:${len}px;border-left:${thick}px solid ${color};border-bottom:${thick}px solid ${color};"></div>
  <div style="position:absolute;right:0;bottom:0;width:${len}px;height:${len}px;border-right:${thick}px solid ${color};border-bottom:${thick}px solid ${color};"></div>`;
}
// mascote (caricatura) - circulo pro canto do rodape
function mascotAvatar(size){
  const b=Math.max(2,Math.round(size*0.045));
  return `<div style="width:${size}px;height:${size}px;position:relative;display:flex;overflow:hidden;border-radius:${size/2}px;border:${b}px solid ${GREEN};background:#120a1e;box-shadow:0 0 0 ${b}px ${PURPLE};flex:0 0 auto;"><img src="${MASCOT}" style="position:absolute;left:${-size*0.26}px;top:${-size*0.12}px;width:${size*1.5}px;height:${size*1.5}px;object-fit:contain;" /></div>`;
}

// Rótulo editorial: prefere o selo contextual do agente; cai no fixo por tipo se vazio.
function kickerFor(tipo, selo){
  const map = { contexto:'O LANÇAMENTO', evidencia:'CONFIRMADO', impacto:'POR QUE IMPORTA', acao:'O QUE FAZER' };
  const s = String(selo||'').trim();
  return s || map[tipo] || 'NOTÍCIA';
}
// Tratamento de hero por papel editorial - mesma foto vira visuais distintos.
function treatmentFor(tipo, pagina){
  const map = { contexto:'full', evidencia:'detail', impacto:'duotone', acao:'contain' };
  if (map[tipo]) return map[tipo];
  const cycle = ['full','detail','duotone','contain'];
  return cycle[(Number(pagina||2)-2+4)%4];
}

// moldura HUD do hero (unificada capa+slides)
function heroFrame(inner, x, y, W, H, credit){
  const creditTag = credit ? `<div style="position:absolute;right:0;bottom:0;display:flex;padding:9px 16px;background:rgba(5,6,7,.82);color:#c9cfd7;font-size:13px;font-weight:800;letter-spacing:2px;">${credit}</div>` : '';
  const accent = `<div style="position:absolute;left:0;bottom:0;width:100%;height:8px;display:flex;background:linear-gradient(90deg,${GREEN} 0%,${GREEN} 58%,${PURPLE} 58%,${PURPLE} 100%);box-shadow:0 0 20px rgba(155,255,37,.35);"></div>`;
  return `<div style="position:absolute;left:${x}px;top:${y}px;width:${W}px;height:${H}px;display:flex;overflow:hidden;background:#0a0d11;box-shadow:0 20px 52px rgba(0,0,0,.6);">`+
    inner + creditTag + brackets(GREEN,36,4) + accent + `</div>`;
}

function heroBox(source, treatment, credit, x, y, W, H){
  const SW=Math.round(W*1.6), SH=Math.round(H*1.6);
  if (treatment==='detail'){
    const img = cloud(source, `c_thumb,g_auto,z_1.35,w_${SW},h_${SH},${QUAL}`);
    return heroFrame(`<img src="${img}" style="position:absolute;inset:0;width:${W}px;height:${H}px;object-fit:cover;" />`, x,y,W,H, credit);
  }
  if (treatment==='duotone'){
    const img = cloud(source, `c_fill,g_auto,e_grayscale,w_${SW},h_${SH},${QUAL}`);
    return heroFrame(
      `<img src="${img}" style="position:absolute;inset:0;width:${W}px;height:${H}px;object-fit:cover;" />`+
      `<div style="position:absolute;inset:0;display:flex;background:${GREEN};mix-blend-mode:multiply;opacity:.42;"></div>`+
      `<div style="position:absolute;inset:0;display:flex;background:radial-gradient(circle at 80% 22%,${PURPLE} 0%,rgba(139,44,255,0) 55%);mix-blend-mode:screen;opacity:.38;"></div>`,
      x,y,W,H, credit);
  }
  if (treatment==='contain'){
    const bg = cloud(source, `c_fill,g_auto,w_${SW},h_${SH},${QUAL}`);
    const fg = cloud(source, `c_fit,w_${Math.round((W-40)*1.6)},h_${Math.round((H-40)*1.6)},${QUAL}`);
    return heroFrame(
      `<img src="${bg}" style="position:absolute;inset:-30px;width:${W+60}px;height:${H+60}px;object-fit:cover;filter:blur(26px) brightness(.4) saturate(1.25);transform:scale(1.06);" />`+
      `<img src="${fg}" style="position:absolute;inset:0;width:${W}px;height:${H}px;object-fit:contain;filter:drop-shadow(0 12px 22px rgba(0,0,0,.6));" />`,
      x,y,W,H, credit);
  }
  const img = cloud(source, `c_fill,g_auto,w_${SW},h_${SH},${QUAL}`);
  return heroFrame(`<img src="${img}" style="position:absolute;inset:0;width:${W}px;height:${H}px;object-fit:cover;" />`, x,y,W,H, credit);
}

function splitbar(){
  return `<div style="position:absolute;left:0;top:0;width:1080px;height:6px;display:flex;background:linear-gradient(90deg,${GREEN} 0%,${GREEN} 60%,${PURPLE} 60%,${PURPLE} 100%);box-shadow:0 0 14px rgba(155,255,37,.24);"></div>`;
}
function header(pagina, total){
  return `
  <div style="position:absolute;left:72px;top:52px;display:flex;align-items:center;">
    <div style="display:flex;width:7px;height:36px;background:${GREEN};margin-right:14px;box-shadow:0 0 10px rgba(155,255,37,.4);"></div>
    <div style="display:flex;color:#fff;font-size:32px;font-weight:800;letter-spacing:.3px;">Promo<span style="color:${GREEN};">Liso</span></div>
  </div>
  <div style="position:absolute;right:72px;top:50px;display:flex;align-items:center;height:40px;padding:0 16px;background:${GREEN};color:${INK};font-family:${DISPLAY};font-size:30px;font-weight:900;letter-spacing:1px;box-shadow:0 0 16px rgba(155,255,37,.24);">${pagina}<span style="opacity:.55;">/${total}</span></div>`;
}

// ---------- SLIDE DE CONTEUDO ----------
function buildSlide(slide){
  const isCta = slide.tipo === 'cta';
  if (isCta) return buildCta(slide);
  const pagina = String(slide.pagina||2).padStart(2,'0');
  const total = String(slide.total||6).padStart(2,'0');
  const kicker = esc(kickerFor(slide.tipo, slide.selo));
  const texto = esc(slide.texto||'');
  const credit = 'FOTO: '+esc(slide.fonte_imagem||'OFICIAL');
  const treatment = treatmentFor(slide.tipo, slide.pagina);
  const source = /^https:\/\//i.test(String(slide.imagem||'')) ? slide.imagem : slide.capaFallback;

  const HX=72, HY=124, HW=936, HH=478;
  const CW = 936;

  const html = `${STYLE}
<div style="width:1080px;height:1350px;position:relative;display:flex;overflow:hidden;background:${INK};font-family:Arial,Helvetica,sans-serif;">
  <div style="position:absolute;inset:0;display:flex;background:radial-gradient(circle at 85% 12%,rgba(139,44,255,.22) 0%,rgba(139,44,255,0) 46%),radial-gradient(circle at 8% 96%,rgba(155,255,37,.12) 0%,rgba(155,255,37,0) 42%),linear-gradient(155deg,#050607 0%,#090c10 58%,#120420 100%);"></div>
  ${splitbar()}
  ${header(pagina,total)}
  ${heroBox(source, treatment, credit, HX,HY,HW,HH)}

  <div style="position:absolute;left:72px;right:72px;top:648px;bottom:118px;display:flex;flex-direction:column;overflow:hidden;">
    <div style="display:flex;align-items:center;">
      <div style="display:flex;padding:9px 15px;background:${PURPLE};color:#fff;font-size:15px;font-weight:900;letter-spacing:3px;">${kicker}</div>
    </div>
    <div style="display:flex;flex-direction:column;margin-top:22px;">
      ${titleBlock(slide.titulo, CW, 104, 62)}
      <div style="display:flex;margin-top:14px;">${destaqueBlock(slide.destaque, CW, 76, 48)}</div>
    </div>
    <div style="display:flex;width:912px;margin-top:26px;color:#e6ebf2;font-size:33px;line-height:1.36;">${texto}</div>
  </div>

  <div style="position:absolute;left:72px;right:72px;bottom:48px;height:56px;display:flex;align-items:center;justify-content:space-between;border-top:2px solid #23282f;padding-top:16px;box-sizing:content-box;">
    <div style="display:flex;align-items:center;">
      ${mascotAvatar(54)}
      <div style="display:flex;margin-left:14px;color:#aab4c1;font-size:21px;font-weight:800;letter-spacing:1px;">@promoliso0</div>
    </div>
    <div style="display:flex;align-items:center;">
      <div style="display:flex;color:${GREEN};font-family:${DISPLAY};font-size:26px;font-weight:900;letter-spacing:4px;margin-right:12px;">ARRASTE</div>
      ${chevrons(40)}
    </div>
  </div>
</div>`;
  return [{ json: { html, slide } }];
}

// ---------- CAPA ----------
function buildCapa(output){
  const slide = output.slides[0];
  const source = /^https:\/\//i.test(String(slide.imagem||'')) ? slide.imagem : output.capa;
  const kicker = esc(output.categoria || slide.selo || 'NOTÍCIA');
  const credit = esc(slide.fonte_imagem || (output.fontes&&output.fontes[0]&&output.fontes[0].nome) || 'OFICIAL');
  function subCap(t){ t=String(t||'').trim(); const dot=t.search(/[.!?]\s/); if(dot>0&&dot<=95) return t.slice(0,dot+1); if(t.length<=92) return t; let c=t.slice(0,92); const sp=c.lastIndexOf(' '); return (sp>50?c.slice(0,sp):c).replace(/[\s,;:]+$/,'')+'…'; }
  const subtitulo = esc(slide.subtitulo || subCap(slide.texto) || slide.destaque);

  // hero contido (produto INTEIRO) dentro da MESMA moldura HUD dos slides
  const HX=72, HY=116, HW=936, HH=564;
  const bg = cloud(source, `c_fill,g_auto,w_1600,h_1040,${QUAL}`);
  const fg = cloud(source, `c_fit,w_1520,h_1020,${QUAL}`);
  const heroInner =
    `<img src="${bg}" style="position:absolute;inset:-30px;width:${HW+60}px;height:${HH+60}px;object-fit:cover;filter:blur(30px) brightness(.34) saturate(1.3);transform:scale(1.06);" />`+
    `<div style="position:absolute;inset:0;display:flex;background:radial-gradient(circle at 50% 46%,rgba(155,255,37,.16) 0%,rgba(155,255,37,0) 58%);"></div>`+
    `<img src="${fg}" style="position:absolute;inset:0;width:${HW}px;height:${HH}px;object-fit:contain;filter:drop-shadow(0 16px 30px rgba(0,0,0,.6));" />`;

  const CW = 936;

  const html = `${STYLE}
<div style="width:1080px;height:1350px;position:relative;display:flex;overflow:hidden;background:${INK};font-family:Arial,Helvetica,sans-serif;">
  <div style="position:absolute;inset:0;display:flex;background:radial-gradient(circle at 84% 84%,rgba(139,44,255,.24) 0%,rgba(139,44,255,0) 48%),linear-gradient(160deg,#050607 0%,#090c10 55%,#130421 100%);"></div>
  ${splitbar()}

  <div style="position:absolute;left:72px;top:52px;display:flex;align-items:center;">
    <div style="display:flex;width:7px;height:38px;background:${GREEN};margin-right:14px;box-shadow:0 0 14px rgba(155,255,37,.6);"></div>
    <div style="display:flex;color:#fff;font-size:34px;font-weight:800;">Promo<span style="color:${GREEN};">Liso</span></div>
  </div>
  <div style="position:absolute;right:72px;top:56px;display:flex;padding:8px 14px;background:rgba(5,6,7,.7);color:#c9cfd7;font-size:13px;font-weight:800;letter-spacing:2px;">FOTO: ${credit}</div>

  ${heroFrame(heroInner, HX,HY,HW,HH, '')}

  <div style="position:absolute;left:72px;right:72px;top:712px;bottom:150px;display:flex;flex-direction:column;overflow:hidden;">
    <div style="display:flex;align-items:center;">
      ${chevrons(30)}
      <div style="display:flex;margin-left:12px;padding:9px 16px;background:${GREEN};color:${INK};font-size:18px;font-weight:900;letter-spacing:3px;box-shadow:0 0 22px rgba(155,255,37,.4);">${kicker}</div>
    </div>
    <div style="display:flex;flex-direction:column;margin-top:16px;">
      ${titleBlock(slide.titulo, CW, 88, 52)}
      <div style="display:flex;margin-top:12px;">${destaqueBlock(slide.destaque, CW, 66, 44, true)}</div>
    </div>
    <div style="display:flex;width:930px;margin-top:16px;color:#dfe5ec;font-size:26px;line-height:1.3;font-weight:600;">${subtitulo}</div>
  </div>

  <div style="position:absolute;left:72px;bottom:56px;display:flex;align-items:center;">
    <div style="display:flex;align-items:center;height:60px;padding:0 22px;background:${GREEN};color:${INK};font-family:${DISPLAY};font-size:32px;font-weight:900;letter-spacing:2px;box-shadow:0 0 26px rgba(155,255,37,.45);">ARRASTE PRA VER</div>
    <div style="display:flex;align-items:center;height:60px;padding:0 14px;background:${PURPLE};">${chevrons(44)}</div>
  </div>
</div>`;
  return [{ json: { html, capaUsada: fg, output } }];
}

// ---------- CTA (preenche a altura toda) ----------
function buildCta(slide){
  const total = String(slide.total||6).padStart(2,'0');
  const CW = 540;
  const html = `${STYLE}
<div style="width:1080px;height:1350px;position:relative;display:flex;overflow:hidden;background:${INK};font-family:Arial,Helvetica,sans-serif;">
  <div style="position:absolute;inset:0;display:flex;background:radial-gradient(circle at 74% 42%,rgba(139,44,255,.38) 0%,rgba(139,44,255,0) 46%),radial-gradient(circle at 16% 80%,rgba(155,255,37,.18) 0%,rgba(155,255,37,0) 40%),linear-gradient(150deg,#050607 0%,#0a0d12 58%,#12041d 100%);"></div>
  ${splitbar()}
  <div style="position:absolute;left:0;bottom:0;width:1080px;height:8px;display:flex;background:linear-gradient(90deg,${PURPLE} 0%,${PURPLE} 40%,${GREEN} 40%,${GREEN} 100%);box-shadow:0 0 18px rgba(155,255,37,.4);"></div>

  <div style="position:absolute;left:72px;top:60px;display:flex;align-items:center;">
    <div style="display:flex;width:7px;height:38px;background:${GREEN};margin-right:14px;box-shadow:0 0 14px rgba(155,255,37,.6);"></div>
    <div style="display:flex;color:#fff;font-size:34px;font-weight:800;">Promo<span style="color:${GREEN};">Liso</span></div>
  </div>

  <div style="position:absolute;left:72px;top:236px;right:452px;display:flex;flex-direction:column;">
    <div style="display:flex;align-items:center;">
      ${chevrons(30)}
      <div style="display:flex;margin-left:12px;padding:9px 15px;background:${PURPLE};color:#fff;font-size:16px;font-weight:900;letter-spacing:3px;align-self:flex-start;">SÓ QUEM SEGUE VÊ 1º</div>
    </div>
    <div style="display:flex;flex-direction:column;margin-top:24px;color:#fff;font-family:${DISPLAY};font-size:118px;line-height:.84;font-weight:900;letter-spacing:-2px;text-transform:uppercase;text-shadow:0 3px 18px rgba(0,0,0,.7);">
      <span style="display:flex;">Entre no</span><span style="display:flex;">grupo de</span>
    </div>
    <div style="display:flex;align-self:flex-start;margin-top:12px;background:${GREEN};color:${INK};font-family:${DISPLAY};font-size:118px;line-height:.9;font-weight:900;letter-spacing:-2px;text-transform:uppercase;padding:2px 18px;box-shadow:0 0 34px rgba(155,255,37,.5);">Promoções</div>
    <div style="display:flex;width:${CW}px;margin-top:30px;color:#c4ccd6;font-size:28px;font-weight:600;line-height:1.34;">As melhores ofertas de games e hardware caem primeiro no grupo.</div>
  </div>

  <img src="${MASCOT}" style="position:absolute;right:-30px;bottom:0;width:580px;height:580px;object-fit:contain;object-position:right bottom;filter:drop-shadow(0 16px 22px rgba(0,0,0,.7));" />

  <div style="position:absolute;left:72px;bottom:72px;display:flex;flex-direction:column;">
    <div style="display:flex;align-items:center;">
      <div style="display:flex;align-items:center;height:70px;padding:0 26px;background:${GREEN};color:${INK};font-family:${DISPLAY};font-size:38px;font-weight:900;letter-spacing:1px;box-shadow:0 0 30px rgba(155,255,37,.5);">LINK NA BIO</div>
      <div style="display:flex;width:70px;height:70px;align-items:center;justify-content:center;background:${PURPLE};color:#fff;font-size:38px;font-weight:700;">↗</div>
    </div>
    <div style="display:flex;margin-top:18px;color:#fff;font-size:32px;font-weight:900;letter-spacing:.5px;">@promoliso0</div>
  </div>
</div>`;
  return [{ json: { html, slide } }];
}

// ---------- runner ----------
function render(html, w, h, outFile){
  return new Promise((resolve,reject)=>{
    const body=JSON.stringify({html,width:w,height:h,quality:95});
    const req=http.request({host:'127.0.0.1',port:5680,path:'/render',method:'POST',headers:{'content-type':'application/json','content-length':Buffer.byteLength(body)}},res=>{
      const ch=[];res.on('data',c=>ch.push(c));res.on('end',()=>{const b=Buffer.concat(ch);if(res.statusCode!==200){reject(new Error('HTTP '+res.statusCode+' '+b.toString().slice(0,300)));return;}fs.writeFileSync(path.join(OUT,outFile),b);console.log('WROTE',outFile,b.length,'bytes',res.headers['x-render-time-ms']+'ms');resolve();});
    });
    req.on('error',reject);req.write(body);req.end();
  });
}

if (require.main===module){(async()=>{
  const output=JSON.parse(fs.readFileSync(path.join(OUT, process.argv[2]||'exec87_output.json'),'utf8'));
  const p=process.argv[3]||'after';
  await render(buildCapa(output)[0].json.html,1080,1350,`${p}_1_capa.jpg`);
  const tipos=['contexto','evidencia','impacto','acao'];
  for(let i=0;i<4;i++){
    const s={...output.slides[i+1],pagina:i+2,total:6,capaFallback:output.capa,tipo:tipos[i]};
    await render(buildSlide(s)[0].json.html,1080,1350,`${p}_${i+2}_slide.jpg`);
  }
  await render(buildSlide({tipo:'cta',total:6})[0].json.html,1080,1350,`${p}_6_cta.jpg`);
  console.log('done');
})().catch(e=>{console.error('ERR',e);process.exit(1);});}

module.exports={buildCapa,buildSlide};
