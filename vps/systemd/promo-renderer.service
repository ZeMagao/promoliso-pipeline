[Unit]
Description=PromoLiso Renderer (Chrome headless + sharp)
After=network.target

[Service]
Type=simple
User=promo
Group=promo
WorkingDirectory=/opt/promoliso/renderer
Environment=NODE_ENV=production
Environment=CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
Environment=RENDERER_NO_SANDBOX=1
Environment=RENDERER_HOST=127.0.0.1
Environment=RENDERER_PORT=5680
Environment=TZ=America/Sao_Paulo
ExecStart=/usr/bin/node server.cjs
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/promoliso

[Install]
WantedBy=multi-user.target
