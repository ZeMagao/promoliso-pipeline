[Unit]
Description=PromoLiso - vigia FORA do n8n (avisa no Telegram quando a conta para de publicar)
After=network.target

[Service]
Type=oneshot
User=promo
Group=promo
WorkingDirectory=/opt/promoliso
Environment=TZ=America/Sao_Paulo
ExecStart=/usr/bin/node /usr/local/bin/promo-vigia.cjs

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/promo-vigia
