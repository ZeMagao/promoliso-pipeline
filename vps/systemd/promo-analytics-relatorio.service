[Unit]
Description=PromoLiso - relatorio semanal (RF-04)
Documentation=file:/opt/promoliso/analytics/README.md

[Service]
Type=oneshot
User=promo
Group=promo
WorkingDirectory=/opt/promoliso
Environment=TZ=America/Sao_Paulo
Environment=PROMO_RAIZ=/opt/promoliso
Environment=PROMO_ANALYTICS_LOG_DIR=/opt/promoliso/analytics/logs
ExecStart=/usr/bin/node /opt/promoliso/analytics/relatorio-semanal.cjs
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
