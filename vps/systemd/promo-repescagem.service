[Unit]
Description=PromoLiso - devolve à disputa a pauta aprovada cuja rodada morreu (status error)
Documentation=file:/usr/local/bin/promo-repescagem.cjs
After=promo-n8n.service

[Service]
Type=oneshot
User=promo
Group=promo
WorkingDirectory=/opt/promoliso
ExecStart=/usr/bin/node /usr/local/bin/promo-repescagem.cjs
Nice=10
