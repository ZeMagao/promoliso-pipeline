{
	email <email-do-acme>
}

n8n.promoliso.com.br {
	encode zstd gzip

	# /cdn/<versao>/<id>.jpg — as imagens do carrossel servidas por NÓS (serviço promo-cdn, 5701).
	# Existe porque o buscador de mídia do Meta não baixa do res.cloudinary.com de forma confiável
	# (medido 16/09/2026: 3/8 e 3/6 lá contra 8/8 fora de lá) e os três slots do dia falharam.
	# O matcher é estreito de propósito: só este formato entra, então este host não vira proxy.
	@cdn path_regexp cdnrota ^/cdn/v[0-9]+/[A-Za-z0-9_-]{4,128}\.jpg$
	handle @cdn {
		reverse_proxy 127.0.0.1:5701
	}

	# /jogo/fotos?titulo=... — fotos oficiais do jogo da manchete, pelo mesmo serviço.
	# Sem esta rota o caminho cai no n8n e o fluxo recebe o HTML do editor no lugar do JSON:
	# foi exatamente o que o dry-run do patch pegou ("Unexpected token '<'").
	handle /jogo/fotos {
		reverse_proxy 127.0.0.1:5701
	}

	# /img?u=... — ponte para os hosts que respondem 403 ao buscador do Cloudinary
	# (adrenaline e blogger/GameBlast, medidos em 20/09). A lista de hosts permitidos mora no
	# serviço; aqui só passa o caminho adiante.
	handle /img {
		reverse_proxy 127.0.0.1:5701
	}

	handle {
		reverse_proxy 127.0.0.1:5678 {
			flush_interval -1
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
